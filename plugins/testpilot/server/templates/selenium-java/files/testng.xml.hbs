<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- {{header}} -->
<!-- Tests run in parallel per class; each test gets its own browser (BaseTest). -->
<suite name="{{projectName}} UI tests" parallel="classes" thread-count="2" verbose="1">
  <listeners>
    <listener class-name="{{javaPackage}}.TestPilotListener"/>
  </listeners>
  <test name="UI">
    <packages>
      <package name="{{javaPackage}}.tests.*"/>
    </packages>
  </test>
</suite>
