# {{header}}
# Runs the TestPilot-generated {{title}} tests. Add these under Settings → CI/CD → Variables:
{{#each variables}}
#   {{this}}
{{/each}}
{{#each secrets}}
#   {{this}} (masked and protected)
{{/each}}
{{#if isAppium}}
# Shared runners have no phones, so the tests run on BrowserStack App Automate real devices.
{{/if}}
ui-tests:
  image: {{dockerImage}}
  stage: test
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    - if: $CI_PIPELINE_SOURCE == "schedule"
    - if: $CI_PIPELINE_SOURCE == "web"
  script:
{{#if testRootIsSub}}
    - cd {{testRoot}}
{{/if}}
{{#if isMaven}}
    - {{setupCommand}}
    - {{dockerRunCommand}}
{{else}}
    - npm ci
{{#if setupCommand}}
    - {{setupCommand}}
{{/if}}
    - {{runCommand}}
{{/if}}
  artifacts:
    when: always
    expire_in: 14 days
    paths:
{{#each reportPaths}}
      - {{this}}
{{/each}}
    reports:
      junit: {{junitFiles}}
