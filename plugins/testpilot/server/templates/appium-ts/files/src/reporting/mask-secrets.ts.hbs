// {{header}}
import { existsSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import path from 'node:path';

/** Environment variables whose values must never appear in report files: passwords, PINs, tokens, keys. */
const SECRET_NAME = /pass(word|code)?\b|_pass_|secret|token|api_?key|access_?key|private_?key|\bpin\b|_pin$|credential/i;
const TEXT_FILE = /\.(xml|json|txt|html|log)$/i;
export const MASK = '**MASKED**';

/** The forms a value takes in report files: as typed, inside JSON strings, and XML-escaped. */
function forms(value: string): string[] {
    const json = JSON.stringify(value).slice(1, -1);
    const xml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&apos;');
    return [value, json, xml(value), xml(json), json.replace(/"/g, '&quot;')];
}

/** Values of secret variables (from .env or CI secrets), longest first so longer values are masked whole. */
export function secretValues(env: NodeJS.ProcessEnv = process.env): string[] {
    const values = Object.entries(env)
        .filter(([name, value]) => SECRET_NAME.test(name.toLowerCase().replace(/[^a-z0-9]+/g, '_')) && value && value.length >= 4 && !/^(true|false|null|undefined|\d{1,3})$/i.test(value))
        .flatMap(([, value]) => forms(value as string));
    return [...new Set(values)].sort((a, b) => b.length - a.length);
}

function filesIn(dir: string): string[] {
    if (!existsSync(dir)) return [];
    return readdirSync(dir).flatMap(name => {
        const file = path.join(dir, name);
        return statSync(file).isDirectory() ? filesIn(file) : TEXT_FILE.test(name) ? [file] : [];
    });
}

/**
 * Replaces secret values in the report files under `dirs` with **MASKED**. The JUnit and Allure reporters
 * record every WebDriver command with its arguments, so a password typed into a field would otherwise end up
 * in CI artifacts and test-management imports.
 */
export function maskSecretsInReports(dirs: string[], env: NodeJS.ProcessEnv = process.env): void {
    const secrets = secretValues(env);
    if (!secrets.length) return;
    for (const file of dirs.flatMap(filesIn)) {
        const text = readFileSync(file, 'utf8');
        let masked = text;
        for (const secret of secrets) masked = masked.split(secret).join(MASK);
        if (masked !== text) writeFileSync(file, masked);
    }
}
