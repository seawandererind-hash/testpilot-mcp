// @ts-check
// {{header}}
const dotenv = require('dotenv');

dotenv.config({ path: ['.env', '.env.example'], quiet: true });

/**
 * Reads a required value from .env (or the CI environment) and fails with a clear message.
 * Secrets live only in .env, which git ignores. Never hard-code them in tests.
 * @param {string} name
 * @returns {string}
 */
function requireEnv(name) {
    const value = process.env[name];
    if (!value) {
        throw new Error(`Missing ${name}. Copy .env.example to .env and fill it in (CI: add it as a secret).`);
    }
    return value;
}

/**
 * @param {string} name
 * @param {string} [fallback]
 * @returns {string}
 */
function optionalEnv(name, fallback = '') {
    return process.env[name] ?? fallback;
}

module.exports = { requireEnv, optionalEnv };
