package {{javaPackage}}.config;

import io.github.cdimascio.dotenv.Dotenv;

/**
 * Settings and secrets. Order: the real environment, then .env (git-ignored, your secrets),
 * then .env.example (shared, non-secret defaults such as APP_BASE_URL). Never hard-code secrets.
 */
public final class Env {
    private static final Dotenv SECRETS = Dotenv.configure().filename(".env").ignoreIfMissing().ignoreIfMalformed().load();
    private static final Dotenv DEFAULTS = Dotenv.configure().filename(".env.example").ignoreIfMissing().ignoreIfMalformed().load();

    private Env() {}

    /** A required value; fails with a clear message instead of a NullPointerException later. */
    public static String require(String name) {
        String value = optional(name, "");
        if (value.isBlank()) {
            throw new IllegalStateException("Missing " + name + ". Copy .env.example to .env and fill it in (CI: add it as a secret).");
        }
        return value;
    }

    public static String optional(String name, String fallback) {
        String fromSystem = System.getenv(name);
        if (fromSystem != null && !fromSystem.isBlank()) return fromSystem;
        String fromProperty = System.getProperty(name);
        if (fromProperty != null && !fromProperty.isBlank()) return fromProperty;
        String fromEnvFile = SECRETS.get(name);
        if (fromEnvFile != null && !fromEnvFile.isBlank()) return fromEnvFile;
        String fromDefaults = DEFAULTS.get(name);
        return fromDefaults != null && !fromDefaults.isBlank() ? fromDefaults : fallback;
    }

    public static boolean flag(String name, boolean fallback) {
        String value = optional(name, "");
        return value.isBlank() ? fallback : value.equalsIgnoreCase("true") || value.equals("1") || value.equalsIgnoreCase("yes");
    }
}
