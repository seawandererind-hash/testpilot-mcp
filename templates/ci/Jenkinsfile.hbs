// {{header}}
// Runs the TestPilot-generated Playwright tests. Add these Jenkins credentials (Secret text):
{{#each secrets}}
//   {{this}}
{{/each}}
// and set these as environment values on the job or folder:
{{#each variables}}
//   {{this}}
{{/each}}
pipeline {
    agent {
        docker {
            image 'mcr.microsoft.com/playwright:v{{playwrightVersion}}-noble'
            args '--ipc=host'
        }
    }
    triggers {
        cron('H 2 * * *')
    }
    options {
        timeout(time: 60, unit: 'MINUTES')
    }
{{#if secrets.length}}
    environment {
{{#each secrets}}
        {{this}} = credentials('{{this}}')
{{/each}}
    }
{{/if}}
    stages {
        stage('Install') {
            steps {
                dir('{{testRoot}}') {
                    sh 'npm ci'
                }
            }
        }
        stage('Test') {
            steps {
                dir('{{testRoot}}') {
                    sh 'npx playwright test'
                }
            }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: '{{testRootPrefix}}test-results/junit.xml'
            archiveArtifacts artifacts: '{{testRootPrefix}}playwright-report/**', allowEmptyArchive: true
        }
    }
}
